% Title: The Perturbed Full Two-body Problem: Application to Post-DART Didymos
% purpose: show how modern missions like NASA's DART apply two-body dynamics with perterbations in to real-world asteroid deflection scenarios
@article{meyer,
    doi = {10.3847/PSJ/acebc7},
    url = {https://doi.org/10.3847/PSJ/acebc7},
    year = {2023},
    month = {aug},
    publisher = {The American Astronomical Society},
    volume = {4},
    number = {8},
    pages = {141},
    author = {Meyer, Alex J. and Agrusa, Harrison F. and Richardson, Derek C. and Daly, R. Terik and Fuentes-Muñoz, Oscar and Hirabayashi, Masatoshi and Michel, Patrick and Merrill, Colby C. and Nakano, Ryota and Cheng, Andrew F. and Barbee, Brent and Barnouin, Olivier S. and Chesley, Steven R. and Ernst, Carolyn M. and Gkolias, Ioannis and Moskovitz, Nicholas A. and Naidu, Shantanu P. and Pravec, Petr and Scheirich, Petr and Thomas, Cristina A. and Tsiganis, Kleomenis and Scheeres, Daniel J.},
    title = {The Perturbed Full Two-body Problem: Application to Post-DART Didymos},
    journal = {The Planetary Science Journal},
    abstract = {With the successful impact of the NASA Double Asteroid Redirection Test (DART) spacecraft in the Didymos–Dimorphos binary asteroid system, we provide an initial analysis of the post-impact perturbed binary asteroid dynamics. To compare our simulation results with observations, we introduce a set of “observable elements” calculated using only the physical separation of the binary asteroid, rather than traditional Keplerian elements. Using numerical methods that treat the fully spin–orbit-coupled dynamics, we estimate the system’s mass and the impact-induced changes in orbital velocity, semimajor axis, and eccentricity. We find that the changes to the mutual orbit depend strongly on the separation distance between Didymos and Dimorphos at the time of impact. If Dimorphos enters a tumbling state after the impact, this may be observable through changes in the system’s eccentricity and orbit period. We also find that any DART-induced reshaping of Dimorphos would generally reduce the required change in orbital velocity to achieve the measured post-impact orbit period, and will be assessed by the ESA Hera mission in 2027.}
}

% Title: Defining and cataloging exoplanets: the exoplanet.eu database
% purpose: highlight role of two-body (and N-body) orbital modelling in exoplanet deflection + classification
@article{schneider,
    abstract = {We describe an online database for extrasolar planetary-mass candidates, which is updated regularly as new data are available. We first discuss criteria for inclusion of objects in the catalog: “definition” of a planet and several aspects of the confidence level of planet candidates. We are led to point out the contradiction between the sharpness of criteria for belonging to a catalog and the fuzziness of the confidence level for an object to be a planet. We then describe the different tables of extrasolar planetary systems, including unconfirmed candidates (which will ultimately be confirmed, or not, by direct imaging). It also provides online tools: histograms of planet and host star data, cross-correlations between these parameters, and some Virtual Observatory services. Future evolutions of the database are presented.},
    author = {Schneider, J. and Dedieu, C. and Le Sidaner, P. and Savalle, R. and Zolotukhin, I.},
    address = {LES ULIS CEDEX A},
    copyright = {Copyright 2016 Elsevier B.V., All rights reserved.},
    issn = {0004-6361},
    journal = {Astronomy and astrophysics (Berlin)},
    keywords = {Astrophysics ;  Physical sciences ;  Planetary systems},
    language = {eng},
    pages = {A79-},
    publisher = {EDP Sciences},
    title = {Defining and cataloging exoplanets: the exoplanet.eu database},
    volume = {532},
    year = {2011},
}



